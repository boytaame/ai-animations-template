{
  "name": "lowpoly-diorama-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Remotion + Three.js kit for refined low-poly 3D vertical videos",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts Demo out/stills/demo-0060.png --frame=60 --gl=angle",
    "still:gallery": "remotion still src/index.ts Gallery out/stills/gallery.png --frame=40 --gl=angle",
    "still:characters": "remotion still src/index.ts CharacterShowcase out/stills/characters.png --frame=30 --gl=angle",
    "render:draft": "remotion render src/index.ts Demo out/draft.mp4 --scale=0.5 --crf=28 --codec=h264 --pixel-format=yuv420p --gl=angle --image-format=jpeg --jpeg-quality=90",
    "render:final": "remotion render src/index.ts Demo out/final.mp4 --crf=16 --codec=h264 --pixel-format=yuv420p --audio-bitrate=192k --gl=angle --image-format=jpeg --jpeg-quality=95",
    "captions": "node scripts/make-captions.mjs",
    "audio:prep": "node scripts/prepare-audio.mjs",
    "check:motion": "node scripts/check-motion.mjs out/draft.mp4",
    "check:determinism": "node scripts/check-determinism.mjs",
    "check:video": "node scripts/check-video.mjs out/final.mp4",
    "contact-sheet": "node scripts/contact-sheet.mjs out/draft.mp4 out/contact-sheet.png",
    "test:kit": "node --import tsx --test tests/keyframes.test.mjs tests/captions.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/install-whisper-cpp": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "@remotion/motion-blur": "4.0.539",
    "@remotion/three": "4.0.539",
    "postprocessing": "6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
